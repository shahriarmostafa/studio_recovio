DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_SCHEMA=studio_recovio
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
PORTAL_ORIGIN=http://localhost:4000
WEBSITE_ORIGINS=http://localhost:3003,http://localhost:3000
WEBSITE_URL=http://localhost:3003
# Defaults to false in production. Enable only when public intake is ready.
APPLICATIONS_ENABLED=false
# For production HTTPS, set NODE_ENV=production. Only enable proxy trust for your exact proxy IP/CIDR.
TRUST_PROXY=
# Optional for the first admin CLI; generates a password if omitted. Never commit it.
ADMIN_EMAIL=admin@studiorecovio.example
ADMIN_NAME=Amministratore Studio
